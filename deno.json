{
    "name": "@me/nintendo",
    "compilerOptions": {
        "checkJs": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["DOM", "esnext"],
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strict": true
    },
    "exports": "./app.ts",
    "imports": {
        "~/": "./",
        "@me/": "./js/@me/"
    },
    "lint": {
        "rules": {
            "exclude": ["ban-ts-comment", "no-this-alias", "no-window"]
        }
    },
    "nodeModulesDir": "manual",
    "tasks": {
        "run": "python -m http.server -b localhost 8000"
    }
}